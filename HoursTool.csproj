<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HoursTool</AssemblyName>
    <RootNamespace>HoursTool</RootNamespace>
    <Version>2.0.0</Version>
    <Product>Hours Tool</Product>
    <Description>Timesheet export analysis (invoiced vs. overhead hours, customers, trends).</Description>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- missing XML comments on private/generated members are not errors -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- single-file exe (build.bat). Override for other platforms: dotnet publish -r linux-x64 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- self-contained by default; framework-dependent build: -p:SelfContained=false (see build.bat) -->
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- native libraries (SkiaSharp, HarfBuzz) are not part of .NET, so they are always bundled -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- compression is only supported for self-contained single-file bundles -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- tests live in their own project -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <AvaloniaResource Include="Assets/**" />
    <AvaloniaResource Include="docs/USER_GUIDE.*.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.1.5" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.0.47" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
  </ItemGroup>
</Project>
