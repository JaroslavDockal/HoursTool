<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        x:Class="HoursTool.MainWindow"
        Title="Hours Tool" Width="1700" Height="980" MinWidth="1100" MinHeight="650">
  <DockPanel>

    <!-- horni lista -->
    <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <ComboBox x:Name="CmbTheme" DockPanel.Dock="Right" SelectedIndex="0" Width="140">
          <ComboBoxItem Content="Téma: systém" />
          <ComboBoxItem Content="Téma: světlé" />
          <ComboBoxItem Content="Téma: tmavé" />
        </ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Hours Tool" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"
                     Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
          <Button x:Name="BtnOpen" Classes="accent" Content="Načíst xlsx..." />
          <Button x:Name="BtnClear" Content="Vymazat data" />
          <Border Width="1" Background="{DynamicResource CardBorder}" Margin="6,2" />
          <Button x:Name="BtnExport" Content="Export do Excelu" />
          <Button x:Name="BtnExportCharts" Content="Export grafů (PNG)" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- stavovy radek -->
    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="14,5">
      <TextBlock x:Name="TxtStatus" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- levy panel s filtry -->
    <Border DockPanel.Dock="Left" Classes="side" Width="350">
      <ScrollViewer>
        <StackPanel Margin="10" Spacing="6">
          <Border Classes="card" Padding="12,8">
            <StackPanel Spacing="2">
              <CheckBox x:Name="ChkFiSplit" Content="Rozklad FI (newbuild / P / ostatní)" FontWeight="SemiBold" />
              <TextBlock Classes="hint" Text="Zapne rozklad FI v tabulce, grafech, donutu a detailu osoby." />
            </StackPanel>
          </Border>

          <Expander Header="Období" IsExpanded="True">
            <StackPanel Spacing="6">
              <TextBlock Text="Roky" Classes="lbl" />
              <WrapPanel x:Name="PnlYears" />
              <TextBlock Text="Měsíce" Classes="lbl" Margin="0,4,0,0" />
              <WrapPanel x:Name="PnlMonths" />
              <CheckBox x:Name="ChkCommon" Content="Jen měsíce společné pro všechny vybrané roky" />
            </StackPanel>
          </Expander>

          <Expander Header="Organizace" IsExpanded="True">
            <StackPanel Spacing="6">
              <TextBlock Text="Cost centra" Classes="lbl" />
              <WrapPanel x:Name="PnlCc" />
              <TextBlock Text="Zákazník (invoiced)" Classes="lbl" Margin="0,4,0,0" />
              <WrapPanel x:Name="PnlCust" />
            </StackPanel>
          </Expander>

          <Expander Header="Typ hodin a jednotka" IsExpanded="True">
            <StackPanel Spacing="6">
              <TextBlock Text="Jednotka" Classes="lbl" />
              <ComboBox x:Name="CmbUnit" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Hodiny" />
                <ComboBoxItem Content="CZK (sales rate, jen invoiced)" />
              </ComboBox>
              <TextBlock Text="Typ hodin" Classes="lbl" Margin="0,4,0,0" />
              <ComboBox x:Name="CmbScope" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Vše" />
                <ComboBoxItem Content="Jen invoiced (ne-overhead)" />
                <ComboBoxItem Content="Jen overhead" />
              </ComboBox>
              <TextBlock Text="FI newbuild / P projekty" Classes="lbl" Margin="0,4,0,0" />
              <ComboBox x:Name="CmbNb" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Vše" />
                <ComboBoxItem Content="Jen FI newbuild" />
                <ComboBoxItem Content="Bez FI newbuild" />
                <ComboBoxItem Content="Jen P projekty" />
              </ComboBox>
            </StackPanel>
          </Expander>

          <Expander Header="Projekt" IsExpanded="False">
            <StackPanel Spacing="6">
              <TextBlock Classes="hint" Text="ID nebo popis obsahuje. Více výrazů oddělte středníkem, výraz s - na začátku vyloučí." />
              <TextBox x:Name="TxtProject" Watermark="např. COM; -DD" />
            </StackPanel>
          </Expander>

          <Expander Header="Sloupce tabulky" IsExpanded="False">
            <StackPanel Spacing="6">
              <TextBlock Text="Měsíční sloupce" Classes="lbl" />
              <StackPanel x:Name="PnlMonthly" />
              <TextBlock Text="Souhrnné sloupce" Classes="lbl" Margin="0,6,0,0" />
              <StackPanel x:Name="PnlSummary" />
            </StackPanel>
          </Expander>

          <Expander Header="Lidé (dočasné skrytí)" IsExpanded="False">
            <StackPanel Spacing="6">
              <TextBox x:Name="TxtPeople" Watermark="hledat..." />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="BtnAll" Content="Vybrat zobrazené" />
                <Button x:Name="BtnNone" Content="Zrušit zobrazené" />
              </StackPanel>
              <ScrollViewer MaxHeight="340"><StackPanel x:Name="PnlPeople" /></ScrollViewer>
            </StackPanel>
          </Expander>

          <Button x:Name="BtnReset" Content="Reset filtrů" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- obsah -->
    <TabControl Margin="4,4,0,0">

      <TabItem Header="Přehled">
        <Grid RowDefinitions="Auto,Auto,*" Margin="12">
          <WrapPanel x:Name="PnlKpi" Grid.Row="0" />
          <TextBlock Grid.Row="1" Classes="h" Text="Statistiky po letech" />
          <DataGrid x:Name="GridStats" Grid.Row="2" IsReadOnly="True" CanUserSortColumns="False" Margin="0,4,0,0" />
        </Grid>
      </TabItem>

      <TabItem Header="Tabulka">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="card" Margin="8,8,8,4" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Řádky" Classes="lbl" />
              <ComboBox x:Name="CmbGroup" SelectedIndex="0" Width="150">
                <ComboBoxItem Content="Osoba" />
                <ComboBoxItem Content="Cost centrum" />
                <ComboBoxItem Content="Zákazník" />
                <ComboBoxItem Content="Projekt" />
                <ComboBoxItem Content="Rok" />
              </ComboBox>
              <TextBlock Text="Sloupce" Classes="lbl" />
              <ComboBox x:Name="CmbCols" SelectedIndex="0" Width="150">
                <ComboBoxItem Content="Měsíce" />
                <ComboBoxItem Content="Roky" />
                <ComboBoxItem Content="Jen souhrn" />
              </ComboBox>
              <TextBlock Text="Řazení" Classes="lbl" />
              <ComboBox x:Name="CmbSort" SelectedIndex="0" Width="190">
                <ComboBoxItem Content="Abecedně" />
                <ComboBoxItem Content="Invoiced sestupně" />
                <ComboBoxItem Content="Inv % sestupně" />
              </ComboBox>
            </StackPanel>
          </Border>
          <DataGrid x:Name="Grid" Margin="8,4,8,8" IsReadOnly="True" CanUserSortColumns="False"
                    CanUserResizeColumns="True" FrozenColumnCount="2" />
        </DockPanel>
      </TabItem>

      <TabItem Header="Průběh v čase">
        <sp:AvaPlot x:Name="PlotTime" Margin="8" />
      </TabItem>

      <TabItem Header="Trendy">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="card" Margin="8,8,8,4" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Metrika" Classes="lbl" />
              <ComboBox x:Name="CmbTrend" Width="270" />
              <CheckBox x:Name="ChkMa" Content="Klouzavý průměr" IsChecked="True" />
              <CheckBox x:Name="ChkTrend" Content="Lineární trend" IsChecked="True" />
              <TextBlock Text="Prognóza" Classes="lbl" />
              <ComboBox x:Name="CmbFc" SelectedIndex="2" Width="150">
                <ComboBoxItem Content="Bez prognózy" />
                <ComboBoxItem Content="+1 měsíc" />
                <ComboBoxItem Content="+3 měsíce" />
                <ComboBoxItem Content="+6 měsíců" />
              </ComboBox>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Top" Classes="card" Margin="8,4" Padding="12,8">
            <TextBlock x:Name="TxtTrend" TextWrapping="Wrap" FontSize="12" />
          </Border>
          <sp:AvaPlot x:Name="PlotTrend" Margin="8" />
        </DockPanel>
      </TabItem>

      <TabItem Header="Meziroční srovnání">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="card" Margin="8,8,8,4" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Metrika" Classes="lbl" />
              <ComboBox x:Name="CmbYoy" Width="270" />
              <TextBlock x:Name="TxtYoy" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" MaxWidth="900" />
            </StackPanel>
          </Border>
          <Grid RowDefinitions="*,*">
            <sp:AvaPlot x:Name="PlotYoy" Grid.Row="0" Margin="8,4,8,2" />
            <sp:AvaPlot x:Name="PlotCum" Grid.Row="1" Margin="8,2,8,8" />
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Zákazníci">
        <Grid RowDefinitions="*,*" ColumnDefinitions="*,*" Margin="4">
          <sp:AvaPlot x:Name="PlotCust" Grid.Row="0" Grid.Column="0" Margin="4" />
          <Border Grid.Row="0" Grid.Column="1" Classes="card" Margin="4" Padding="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="h" Text="Podíl zákazníků na invoiced" Margin="4,2,0,4" />
              <sp:AvaPlot x:Name="PlotPie" />
            </DockPanel>
          </Border>
          <sp:AvaPlot x:Name="PlotCustTime" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="4" />
        </Grid>
      </TabItem>

      <TabItem Header="Lidé">
        <sp:AvaPlot x:Name="PlotRank" Margin="8" />
      </TabItem>

      <TabItem Header="Heatmapa">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="card" Margin="8,8,8,4" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Hodnota" Classes="lbl" />
              <ComboBox x:Name="CmbHeat" SelectedIndex="0" Width="230">
                <ComboBoxItem Content="Invoiced" />
                <ComboBoxItem Content="Overhead" />
                <ComboBoxItem Content="Inv %" />
                <ComboBoxItem Content="FI newbuild" />
                <ComboBoxItem Content="FI P projekty" />
                <ComboBoxItem Content="FI ostatní" />
              </ComboBox>
            </StackPanel>
          </Border>
          <sp:AvaPlot x:Name="PlotHeat" Margin="8" />
        </DockPanel>
      </TabItem>

      <TabItem Header="Osoba">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="card" Margin="8,8,8,4" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Osoba" Classes="lbl" />
              <ComboBox x:Name="CmbPerson" Width="290" />
              <TextBlock x:Name="TxtPerson" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" MaxWidth="1000" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="2*,*">
            <sp:AvaPlot x:Name="PlotPerson" Grid.Column="0" Margin="8" />
            <DataGrid x:Name="GridPersonProj" Grid.Column="1" Margin="0,8,8,8" IsReadOnly="True"
                      AutoGenerateColumns="True" CanUserSortColumns="True" />
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Projekty">
        <DataGrid x:Name="GridProj" Margin="8" IsReadOnly="True" AutoGenerateColumns="True" CanUserSortColumns="True" />
      </TabItem>

      <TabItem Header="Kontrola dat">
        <DataGrid x:Name="GridIssues" Margin="8" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Úroveň" Binding="{Binding Level}" Width="90" />
            <DataGridTextColumn Header="Co" Binding="{Binding What}" Width="380" />
            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Nastavení">
        <ScrollViewer>
          <StackPanel Margin="14" Spacing="12" MaxWidth="780" HorizontalAlignment="Left">

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="h" Text="Cost centra a lidé" Margin="0" />
                <TextBlock Text="Cost centra (oddělit čárkou)" Classes="lbl" />
                <TextBox x:Name="TxtSetCc" />
                <TextBlock Text="CC s ručním výběrem lidí (čárkou)" Classes="lbl" Margin="0,6,0,0" />
                <TextBox x:Name="TxtSetRestricted" />
                <TextBlock Text="Relevantní lidé v CC s ručním výběrem" Classes="lbl" Margin="0,6,0,0" />
                <TextBlock Classes="hint" Text="Jedno jméno na řádek, přesně jako v exportu. Ostatní z těchto CC se do dat nezapočítají." />
                <TextBox x:Name="TxtSetPeople" AcceptsReturn="True" Height="180" />
                <Button x:Name="BtnFillPeople" Content="Vložit všechny lidi z těchto CC (pak smažte nerelevantní)" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="h" Text="Klasifikace projektů" Margin="0" />
                <TextBlock Text="Overhead: regex nad SAP Project ID (jeden na řádek)" Classes="lbl" />
                <TextBox x:Name="TxtSetOh" AcceptsReturn="True" Height="70" />
                <TextBlock Text="FI newbuild: regex nad SAP Project ID" Classes="lbl" Margin="0,6,0,0" />
                <TextBox x:Name="TxtSetNb" />
                <TextBlock Text="P projekty (per-request): regex nad SAP Project ID" Classes="lbl" Margin="0,6,0,0" />
                <TextBox x:Name="TxtSetPr" />
                <TextBlock Text="FI newbuild: vyloučené popisy projektů (jeden na řádek)" Classes="lbl" Margin="0,6,0,0" />
                <TextBox x:Name="TxtSetNbEx" AcceptsReturn="True" Height="70" />
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="h" Text="Zákazníci" Margin="0" />
                <TextBlock Text="Zákazníci ve sloupcích (čárkou, kód z ABACUS, např. FI,US,IT,NO)" Classes="lbl" />
                <TextBox x:Name="TxtSetCust" />
              </StackPanel>
            </Border>

            <Button x:Name="BtnApply" Classes="accent" Content="Použít nastavení" HorizontalAlignment="Left" />
            <TextBlock x:Name="TxtCfgPath" Classes="hint" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
